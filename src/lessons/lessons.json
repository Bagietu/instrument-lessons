[
  {
    "id": "piano-middle-c",
    "instrument": "piano",
    "title": "Meet middle C",
    "description": "Find the most important key on the piano.",
    "level": 1,
    "steps": [
      {
        "kind": "info",
        "title": "Finding middle C",
        "text": "Black keys come in groups of two and three. The white key just left of a group of two black keys is C. The C nearest the middle of your piano is middle C. Put your right thumb on it."
      },
      {
        "kind": "notes",
        "instruction": "Play middle C three times with your thumb.",
        "notes": [
          "C4",
          "C4",
          "C4"
        ],
        "hints": [
          "1",
          "1",
          "1"
        ]
      }
    ],
    "position": 0
  },
  {
    "id": "piano-cde",
    "instrument": "piano",
    "title": "C, D and E",
    "description": "Your first three fingers, your first three notes.",
    "level": 1,
    "steps": [
      {
        "kind": "info",
        "text": "Keep your thumb (finger 1) on C, then rest finger 2 on D and finger 3 on E. Fingers stay curved, like holding a small ball."
      },
      {
        "kind": "notes",
        "instruction": "Play up: C, D, E.",
        "notes": [
          "C4",
          "D4",
          "E4"
        ],
        "hints": [
          "1",
          "2",
          "3"
        ]
      },
      {
        "kind": "notes",
        "instruction": "Now back down: E, D, C.",
        "notes": [
          "E4",
          "D4",
          "C4"
        ],
        "hints": [
          "3",
          "2",
          "1"
        ]
      }
    ],
    "position": 1
  },
  {
    "id": "piano-five-finger",
    "instrument": "piano",
    "title": "Five-finger position",
    "description": "One finger per key from C to G.",
    "level": 1,
    "steps": [
      {
        "kind": "info",
        "text": "Add finger 4 on F and finger 5 (your pinky) on G. This is C position: every finger has its own key."
      },
      {
        "kind": "notes",
        "instruction": "Walk up from C to G.",
        "notes": [
          "C4",
          "D4",
          "E4",
          "F4",
          "G4"
        ],
        "hints": [
          "1",
          "2",
