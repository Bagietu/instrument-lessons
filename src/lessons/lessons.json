          "5"
        ]
      },
      {
        "kind": "notes",
        "instruction": "And back down to C.",
        "notes": [
          "G4",
          "F4",
          "E4",
          "D4",
          "C4"
        ],
        "hints": [
          "5",
          "4",
          "3",
          "2",
          "1"
        ]
      }
    ],
    "position": 2
