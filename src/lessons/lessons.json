    "id": "piano-c-scale",
    "instrument": "piano",
    "title": "The C major scale",
    "level": 2,
    "description": "Eight notes with the thumb-under trick.",
    "steps": [
      {
        "kind": "info",
        "title": "Thumb under",
        "text": "Play C, D, E with fingers 1, 2, 3. Then tuck your thumb under to play F, and carry on with 2, 3, 4, 5 up to the next C."
      },
      {
        "kind": "notes",
        "instruction": "Up the scale",
        "notes": [
          "C4",
          "D4",
